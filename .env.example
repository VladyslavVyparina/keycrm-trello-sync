KEYCRM_API_TOKEN=
KEYCRM_BASE_URL=https://openapi.keycrm.app/v1
KEYCRM_PIPELINE_ID=1
# true — не синхронізувати картки без телефону; false — лише попередження в лог (за замовчуванням)
KEYCRM_REQUIRE_PHONE=false
# false — лише переміщувати вже існуючі картки Trello (з lead_id у описі)
SYNC_AUTO_CREATE_TRELLO_CARDS=true

TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BASE_URL=https://api.trello.com/1
TRELLO_BOARD_ID=

POLL_INTERVAL_SECONDS=30
LOG_FILE=logs/sync.log
